# Local SOL development. The service runs separately with npm run oracle.
FORK_LOCAL_SERVICE=http://127.0.0.1:8787
NEXT_PUBLIC_SOLANA_CLUSTER=localnet
NEXT_PUBLIC_SOLANA_RPC=http://127.0.0.1:8899
# Optional deterministic forecasting; contracts still execute on the real validator.
FORK_ENGINE=demo

# Public devnet: use npm run dev:devnet with the existing test operator SIGNER_PATH.
# The startup script sets these consistently; SOL funds deposits and network fees.
# FORK_SERVICE_URL=http://127.0.0.1:8787
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
