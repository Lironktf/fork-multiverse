# Local development only. The services run separately (npm run oracle).
# Mock-USDC service: "If this happens, buy" rules.
FORK_LOCAL_SERVICE=http://127.0.0.1:8787
# Native-SOL service (FORK_COLLATERAL=sol): the Trade tab. Optional; unset hides trading.
# FORK_SOL_SERVICE=http://127.0.0.1:8789
NEXT_PUBLIC_SOLANA_CLUSTER=localnet
NEXT_PUBLIC_SOLANA_RPC=http://127.0.0.1:8899
# Optional deterministic forecasting; contracts still execute on the real validator.
FORK_ENGINE=demo

# Public devnet: npm run dev:devnet starts both services (Helius if ~/.config/helius/api_key
# exists) and the frontend with matching settings.
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
